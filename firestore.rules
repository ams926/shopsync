rules_version = '2';

// Só a conta de administrador pode ler ou escrever.
// ATENÇÃO: ao publicar estas regras, a loja antiga (loja.html) deixa de funcionar,
// porque deixa de conseguir ler os preços e criar pedidos.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sinistroglobal926@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
